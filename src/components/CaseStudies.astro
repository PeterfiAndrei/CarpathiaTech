---
import Section from './Section.astro';
import { caseStudies } from '../data/caseStudies';
---

<Section
  id="case-studies"
  eyebrow="Case studies"
  title="Anonymized, and only what's real"
  subtitle="No client names and no invented numbers — described by industry and project type, web first."
>
  <div class="grid gap-5 lg:grid-cols-2">
    {
      caseStudies.map((cs) => (
        <article
          class={`reveal flex flex-col rounded-xl border bg-surface/50 p-6 sm:p-7 ${
            cs.featured ? 'border-accent/30' : 'border-border'
          }`}
        >
          <div class="mb-4 flex items-center justify-between gap-3">
            <span
              class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${
                cs.featured ? 'bg-accent/15 text-accent' : 'bg-surface-2 text-muted'
              }`}
            >
              {cs.tag}
            </span>
          </div>

          <h3 class="text-lg font-semibold text-fg">{cs.title}</h3>
          <p class="mt-2 text-sm italic leading-relaxed text-faint">{cs.context}</p>

          <dl class="mt-5 space-y-4 border-t border-border pt-5 text-sm leading-relaxed">
            <div>
              <dt class="font-semibold text-fg">Challenge</dt>
              <dd class="mt-1 text-muted">{cs.challenge}</dd>
            </div>
            <div>
              <dt class="font-semibold text-fg">What we did</dt>
              <dd class="mt-1 text-muted">{cs.what}</dd>
            </div>
            <div>
              <dt class="font-semibold text-accent">Outcome</dt>
              <dd class="mt-1 text-muted">{cs.outcome}</dd>
            </div>
          </dl>
        </article>
      ))
    }
  </div>
</Section>
