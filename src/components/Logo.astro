---
/**
 * Logo: minimal geometric mark (mountain peak + checkmark) + text wordmark.
 * The mark subtly references the Carpathian peaks combined with a QA checkmark.
 */
import { config } from '../config';

interface Props {
  class?: string;
  /** Hide the wordmark text (mark only). */
  markOnly?: boolean;
}
const { class: className = '', markOnly = false } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width="28"
    height="28"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <!-- peaks -->
    <path
      d="M3 25 L11 9 L16 18 L20 11 L29 25 Z"
      fill="none"
      stroke="var(--color-accent)"
      stroke-width="2"
      stroke-linejoin="round"
    />
    <!-- checkmark nested in the valley -->
    <path
      d="M11.5 22 L14.5 25 L21 17"
      fill="none"
      stroke="var(--color-fg)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {
    !markOnly && (
      <span class="text-[1.05rem] font-semibold tracking-tight text-fg">
        {config.company.wordmark}
      </span>
    )
  }
</span>
