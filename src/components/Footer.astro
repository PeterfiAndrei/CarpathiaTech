---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { config } from '../config';

// Static copyright year — avoids a client-side date dependency.
// TODO: bump when the year rolls over (or wire up a build-time date).
const year = 2026;
---

<footer class="border-t border-border bg-surface/30">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-3 text-sm leading-relaxed text-muted">
          {config.company.tagline}. {config.company.firstPractice} is our first
          practice.
        </p>
        <p class="mt-3 flex items-center gap-1.5 text-sm text-faint">
          <Icon name="peak" class="h-4 w-4 text-accent" />
          {config.company.location}
        </p>
      </div>

      <nav class="flex gap-10 text-sm" aria-label="Footer">
        <ul class="space-y-2">
          <li><a href="#services" class="text-muted hover:text-fg">Services</a></li>
          <li><a href="#team" class="text-muted hover:text-fg">Team</a></li>
          <li><a href="#case-studies" class="text-muted hover:text-fg">Case studies</a></li>
        </ul>
        <ul class="space-y-2">
          <li><a href="#faq" class="text-muted hover:text-fg">FAQ</a></li>
          <li><a href="#contact" class="text-muted hover:text-fg">Contact</a></li>
          <li>
            <a
              href={config.social.linkedin}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 text-muted hover:text-fg"
            >
              <Icon name="linkedin" class="h-4 w-4" />
              LinkedIn
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {config.company.name}. All rights reserved.</p>
      <p>Senior QA engineering from the EU — working in your time zone.</p>
    </div>
  </div>
</footer>
