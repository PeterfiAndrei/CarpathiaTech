---
import Section from './Section.astro';
import { faqs } from '../data/faq';
---

<Section
  id="faq"
  eyebrow="FAQ"
  title="Questions you're probably asking"
  subtitle="The things an engineering manager usually wants to know before a first call."
>
  <div class="mx-auto max-w-3xl space-y-3">
    {
      faqs.map((f) => (
        <details class="reveal group rounded-xl border border-border bg-surface/50 p-5 open:border-accent/40">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-fg marker:hidden">
            <span>{f.question}</span>
            <svg
              class="h-5 w-5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">{f.answer}</p>
        </details>
      ))
    }
  </div>
</Section>
